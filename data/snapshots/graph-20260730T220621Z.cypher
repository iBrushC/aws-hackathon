// Video Context Graph export
// created 2026-07-30T22:06:21.609304+00:00
// 2 Video, 31 Segment, 52 Entity, 69 Topic, 233 relationships
//
// Paste into Neo4j Browser, or run:
//   cypher-shell -u neo4j -p password -f <this file>
//
// Safe to re-run: every node is MERGE'd on its natural key, so this adds to
// an existing graph rather than replacing it.

// Segment embeddings omitted — re-export with --with-embeddings for
// semantic search.

CREATE CONSTRAINT video_id_unique IF NOT EXISTS FOR (n:Video) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT segment_id_unique IF NOT EXISTS FOR (n:Segment) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT entity_key_unique IF NOT EXISTS FOR (n:Entity) REQUIRE n.key IS UNIQUE;
CREATE CONSTRAINT topic_key_unique IF NOT EXISTS FOR (n:Topic) REQUIRE n.key IS UNIQUE;

// --- Video (2) -----------------------------------------------
UNWIND [
  {`summary`: "The video tours an AWS Builder Loft hackathon and modern office space, featuring interviews and casual conversations among attendees working on AI and agent-based projects. Participants describe projects including Sourcify, a multimedia marketing knowledge base, and a CMO tool using video feedback and Apify scraping, while other discussions touch on Meta Ray-Bans, AWS, Strands Agents, hackathon work, and personal interests such as gardening and Utah trails. It ends with attendees collaborating at laptops in the event space.", `id`: "6a6bb525c1ac59f5d1d11244", `title`: "IMG_2419", `duration_sec`: 1119.221667, `tl_index_id`: "6a6bab0e39bf4592836c2eef", `domain`: "video-context-graph", `url`: "https://deuqpmn4rs7j5.cloudfront.net/6a6b8ea1308815828b42f1bd/assets/6a6bb525c1ac59f5d1d11244/hlses/playlist.m3u8"},
  {`summary`: "At a tech-community hackathon gathering, participants present AI-focused projects and backgrounds. Bryan introduces Sourcify, a multimedia marketing knowledge base for analyzing user-generated content, while Max discusses his AI consultancy and a planned CMO video-feedback tool. Another attendee demos an AI agent, and Alton describes a person-aware note-taking device, as attendees work on laptops and network in an AWS-branded room.", `id`: "6a6bc708c1ac59f5d1d1bfff", `title`: "IMG_2419", `duration_sec`: 1119.2216796875, `tl_index_id`: "6a6bab0e39bf4592836c2eef", `domain`: "video-context-graph", `url`: ""}
] AS row
MERGE (n:Video {id: row.id})
SET n += row;

