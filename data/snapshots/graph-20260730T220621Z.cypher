  {`summary`: "People sit around a table in a modern office. A long-haired woman wearing glasses smiles and speaks toward the camera while colleagues and office supplies are visible nearby.", `id`: "6a6bb525c1ac59f5d1d11244#7", `transcript`: "Yeah, a little basket in front with one of those.", `idx`: 7, `start_sec`: 900.0, `domain`: "video-context-graph", `video_id`: "6a6bb525c1ac59f5d1d11244", `on_screen_text`: "", `end_sec`: 976.0},
  {`summary`: "The camera pans across office desks and workers, settling on a man wearing glasses who looks at a laptop. Large windows reveal buildings outside.", `id`: "6a6bb525c1ac59f5d1d11244#8", `transcript`: "You've got like the hoe in one hand and the...", `idx`: 8, `start_sec`: 976.0, `domain`: "video-context-graph", `video_id`: "6a6bb525c1ac59f5d1d11244", `on_screen_text`: "", `end_sec`: 1018.0},
  {`summary`: "A young man with short hair works at a laptop and uses a mouse. Other employees work in the background, along with a large blue display.", `id`: "6a6bb525c1ac59f5d1d11244#9", `transcript`: "Gorilla Gardening? Yeah, it's kind of Gorilla Gardening on my favorite trails.", `idx`: 9, `start_sec`: 1018.0, `domain`: "video-context-graph", `video_id`: "6a6bb525c1ac59f5d1d11244", `on_screen_text`: "", `end_sec`: 1063.0},
  {`summary`: "A man in glasses, a black T-shirt, and a lanyard stands and speaks to the camera near large windows and an AWS-branded wall.", `id`: "6a6bb525c1ac59f5d1d11244#10", `transcript`: "Yes, he does. His was some of my inspiration. I've done some of that down on Main Street or State Street, which is kind of cool, but up on my favorite trails in the mountain, I'm in Utah.", `idx`: 10, `start_sec`: 1063.0, `domain`: "video-context-graph", `video_id`: "6a6bb525c1ac59f5d1d11244", `on_screen_text`: "AWS", `end_sec`: 1119.0},
