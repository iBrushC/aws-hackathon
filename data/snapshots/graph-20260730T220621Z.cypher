  {`summary`: "The presenter continues speaking and gesturing, with room features and background attendees occasionally visible.", `id`: "6a6bc708c1ac59f5d1d1bfff#15", `transcript`: "", `idx`: 15, `start_sec`: 540.0, `domain`: "video-context-graph", `video_id`: "6a6bc708c1ac59f5d1d1bfff", `on_screen_text`: "", `end_sec`: 560.0},
